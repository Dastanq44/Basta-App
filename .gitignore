# ──────────────────────────────────────────────────────────────
# Basta — React Native / Expo + Supabase .gitignore
# ──────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# EAS
.easignore

# Native — iOS
ios/Pods/
ios/build/
ios/.xcode.env.local
*.xcworkspace/xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3

# Native — Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.keystore
!debug.keystore
android/app/release/

# Metro / React Native
.metro-health-check*
.haste_cache/
*.jsbundle

# Environment & secrets (NEVER commit) — see DECISIONS.md D-001
.env
.env.*
!.env.example
secret*
secrets*
*.secret
*.secrets.json
google-services.json
GoogleService-Info.plist

# Private keys & certificates (NEVER commit)
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
*.jks
*.mobileprovision
id_rsa*
id_ed25519*
*.asc

# Supabase (local dev)
supabase/.branches/
supabase/.temp/
supabase/.env

# Local offline databases (WatermelonDB / SQLite / MMKV)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Testing / coverage
coverage/
.nyc_output/

# Logs & debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# TypeScript / build caches
*.tsbuildinfo
.cache/

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Temporary
*.orig
*.tmp

# Skills CLI artifacts — account-local (re)installs via `npx skills add`.
# The shared project skill `.claude/skills/mobile-app-architect/` stays committed; CLI-installed
# skills, their Claude Code symlinks, and the lockfile are kept out of the app repo.
.agents/
skills-lock.json
.claude/skills/find-skills/
.claude/skills/high-end-visual-design/
