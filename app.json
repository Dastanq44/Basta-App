{
  "expo": {
    "name": "Basta",
    "slug": "basta",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "basta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.basta.mobile"
    },
    "android": {
      "package": "app.basta.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#6C5CE7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
